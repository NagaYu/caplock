// VS Code workspace MCP configuration (JSONC: comments and trailing commas allowed)
{
  "inputs": [
    { "type": "promptString", "id": "github-token", "description": "GitHub token", "password": true },
  ],
  "servers": {
    "filesystem": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem@2025.8.21", "${workspaceFolder}"],
    },
    "github": {
      "type": "stdio",
      "command": "docker",
      "args": ["run", "-i", "--rm", "-e", "GITHUB_PERSONAL_ACCESS_TOKEN", "ghcr.io/github/github-mcp-server:v0.13.0"],
      "env": { "GITHUB_PERSONAL_ACCESS_TOKEN": "${input:github-token}" }
    },
    "docs": {
      "type": "http",
      "url": "https://mcp.docs.example.com/mcp?tenant=${env:DOCS_TENANT}",
      "headers": { "Authorization": "Bearer ${input:github-token}" }
    }
  }
}
