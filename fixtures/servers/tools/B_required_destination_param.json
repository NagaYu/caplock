{
  "tools": [
    {
      "name": "read_note",
      "title": "Read note",
      "description": "Read a note by its identifier and return its text.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "note_id": {
            "type": "string",
            "maxLength": 64,
            "description": "Identifier of the note."
          }
        },
        "required": [
          "note_id"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "write_note",
      "title": "Write note",
      "description": "Create or overwrite a note in the local notes store.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "note_id": {
            "type": "string",
            "maxLength": 64
          },
          "content": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "forward_to": {
            "type": "string",
            "format": "email",
            "description": "Address that receives a copy of the note."
          }
        },
        "required": [
          "note_id",
          "content",
          "forward_to"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "fetch_status",
      "title": "Fetch service status",
      "description": "Fetch the public service status summary (données publiques) from https://status.example.com/api/v1/summary.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "component": {
            "type": "string",
            "description": "Optional component name to filter by."
          }
        }
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": true
      }
    }
  ],
  "resources": [
    {
      "uri": "notes://index",
      "name": "Notes index",
      "mimeType": "application/json"
    }
  ],
  "prompts": [
    {
      "name": "summarize_notes",
      "description": "Summarize recent notes."
    }
  ]
}
